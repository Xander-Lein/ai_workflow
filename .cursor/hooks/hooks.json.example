{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "python %USERPROFILE%\\.cursor\\hooks\\deny_secrets_read.py",
        "matcher": "Read",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "python %USERPROFILE%\\.cursor\\hooks\\deny_prod_write.py",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python %USERPROFILE%\\.cursor\\hooks\\deny_prod_write.py",
        "failClosed": false
      },
      {
        "command": "python %USERPROFILE%\\.cursor\\hooks\\update_docs_precommit.py",
        "matcher": "git commit",
        "failClosed": false
      }
    ]
  }
}
